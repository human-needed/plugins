{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "/usr/bin/curl -s -o /dev/null --connect-timeout 0.3 -m 1.5 --noproxy '*' -H 'Content-Type: application/json' --data-binary '@-' http://127.0.0.1:24816/v1/event/cursor/working; curl.exe -s -o NUL --connect-timeout 0.3 -m 1.5 --noproxy '*' -H 'Content-Type: application/json' --data-binary '@-' http://127.0.0.1:24816/v1/event/cursor/working; exit 0",
        "timeout": 3
      }
    ],
    "stop": [
      {
        "command": "/usr/bin/curl -s -o /dev/null --connect-timeout 0.3 -m 1.5 --noproxy '*' -H 'Content-Type: application/json' --data-binary '@-' http://127.0.0.1:24816/v1/event/cursor/done; curl.exe -s -o NUL --connect-timeout 0.3 -m 1.5 --noproxy '*' -H 'Content-Type: application/json' --data-binary '@-' http://127.0.0.1:24816/v1/event/cursor/done; exit 0",
        "timeout": 3
      }
    ],
    "sessionEnd": [
      {
        "command": "/usr/bin/curl -s -o /dev/null --connect-timeout 0.3 -m 1.5 --noproxy '*' -H 'Content-Type: application/json' --data-binary '@-' http://127.0.0.1:24816/v1/event/cursor/end; curl.exe -s -o NUL --connect-timeout 0.3 -m 1.5 --noproxy '*' -H 'Content-Type: application/json' --data-binary '@-' http://127.0.0.1:24816/v1/event/cursor/end; exit 0",
        "timeout": 3
      }
    ]
  }
}
