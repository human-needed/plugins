{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hn.ps1",
              "working",
              "claude"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_humanneeded_puck__set_state",
            "input": {
              "state": "working",
              "session_id": "${session_id}",
              "agent": "claude"
            },
            "timeout": 5
          },
          {
            "type": "command",
            "command": "echo \"HumanNeeded 0.1.13 hook check: a plugin command hook ran on host $(hostname) ($(uname -s)), entrypoint ${CLAUDE_CODE_ENTRYPOINT:-none}, remote ${CLAUDE_CODE_REMOTE:-none}\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "{ date; uname -a; echo \"root=${CLAUDE_PLUGIN_ROOT}\"; claude --version 2>/dev/null; echo ---; } >> /tmp/hn-hook-check.log 2>&1"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hn.ps1",
              "needs",
              "claude"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_humanneeded_puck__set_state",
            "input": {
              "state": "needs",
              "session_id": "${session_id}",
              "agent": "claude"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hn.ps1",
              "working",
              "claude"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_humanneeded_puck__set_state",
            "input": {
              "state": "working",
              "session_id": "${session_id}",
              "agent": "claude"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hn.ps1",
              "done",
              "claude"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_humanneeded_puck__set_state",
            "input": {
              "state": "done",
              "session_id": "${session_id}",
              "agent": "claude"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-WindowStyle",
              "Hidden",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hn.ps1",
              "end",
              "claude"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_humanneeded_puck__set_state",
            "input": {
              "state": "end",
              "session_id": "${session_id}",
              "agent": "claude"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
