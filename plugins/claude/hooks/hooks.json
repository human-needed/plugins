{
  "description": "HumanNeeded: reports Claude's state to the HumanNeeded app (local, via curl) or, in cloud sessions, to the relay.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/working"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "working"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/working"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "working"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/needs"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "needs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/needs"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "needs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|mcp__computer-use__request_access|mcp__computer-use__request_teach_access",
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/needs"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "needs"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/done"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "done"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl",
            "args": [
              "-s",
              "--connect-timeout",
              "0.3",
              "-m",
              "1",
              "--noproxy",
              "127.0.0.1",
              "-H",
              "Content-Type: application/json",
              "--data-binary",
              "@-",
              "http://127.0.0.1:24816/v1/event/claude/end"
            ],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "end"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
