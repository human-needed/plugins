{
  "description": "HumanNeeded: reports Claude's state to the HumanNeeded app (hn) or, in cloud sessions, to the relay.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "working",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "working"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "working",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "working"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "needs",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "needs"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "needs",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "needs"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "needs",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "needs"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "done",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "done"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hn",
            "args": [
              "event",
              "--agent",
              "claude",
              "--state",
              "end",
              "--stdin-json"
            ],
            "async": true,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/cloud/hn-cloud.sh",
              "end"
            ],
            "async": true,
            "timeout": 5,
            "cloud": "skip"
          }
        ]
      }
    ]
  }
}
