{
  "mcpServers": {
    "puck": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/scripts/hn-mcp.ps1"
      ]
    },
    "puck-mac": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/hn-mcp.sh"
      ]
    }
  }
}
